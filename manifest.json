{
  "manifest_version": 3,
  "name": "Blink Buddy — 20-20-20 Eye Break Reminder",
  "short_name": "Blink Buddy",
  "version": "1.0.0",
  "description": "Rest your eyes with the 20-20-20 rule: every 20 minutes, a gentle reminder to look 20 feet away for 20 seconds.",
  "permissions": ["alarms", "storage", "idle", "offscreen", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "minimum_chrome_version": "120",
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Blink Buddy",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
